#pragma mode( separator(.,;) integer(h32) )
// Test 4: IFERR + loading a PNG from Files into G1 + scaled BLIT_P.
Boot(where)
BEGIN
  LOCAL k,ok,w,h;
  ok:=1;
  IFERR
    G1:=AFiles("icon.png");
  THEN
    ok:=0;
  END;
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,95,20,7,RGB(255,255,255));
  TEXTOUT_P("test 4: image",G0,95,60,4,RGB(62,50,72));
  IF ok THEN
    w:=GROBW_P(G1); h:=GROBH_P(G1);
    TEXTOUT_P("icon.png: "+w+" x "+h,G0,95,90,3,RGB(62,50,72));
    BLIT_P(G0,122,110,198,186,G1,0,0,w,h);
  ELSE
    TEXTOUT_P("icon.png failed to load",G0,70,90,3,RGB(62,50,72));
  END;
  TEXTOUT_P("press Esc",G0,125,205,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;

START()
BEGIN
  Boot("START");
END;
