#pragma mode( separator(.,;) integer(h32) )
// PrimeDF boot test: the smallest possible app program.
// Shows "IT BOOTS" and which entry point the calculator called.
// Esc closes the screen.

Boot(where)
BEGIN
  LOCAL k;
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,95,80,7,RGB(255,255,255));
  TEXTOUT_P("entry: "+where,G0,110,130,4,RGB(62,50,72));
  TEXTOUT_P("press Esc",G0,125,190,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;

START()
BEGIN
  Boot("START");
END;

Symb()
BEGIN
  Boot("Symb");
  STARTVIEW(-1,1);
END;
