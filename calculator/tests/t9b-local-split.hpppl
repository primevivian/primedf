#pragma mode( separator(.,;) integer(h32) )
// Test 9b: 13 locals split over two LOCAL statements (8 + 5).
// Boots = the limit is per statement. Fails = per function.

START()
BEGIN
  LOCAL a1,a2,a3,a4,a5,a6,a7,a8;
  LOCAL b1,b2,b3,b4,k;
  a8:=1; b4:=2;
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,95,60,7,RGB(255,255,255));
  TEXTOUT_P("9b: 13 locals over 2 LOCALs",G0,40,110,3,RGB(62,50,72));
  TEXTOUT_P("press Esc",G0,125,200,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;
