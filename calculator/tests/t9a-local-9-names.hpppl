#pragma mode( separator(.,;) integer(h32) )
// Test 9a: ONE LOCAL statement with 9 names. Expected NOT to boot
// (Check: syntax error at the 9th name). Confirms the limit.

START()
BEGIN
  LOCAL a1,a2,a3,a4,a5,a6,a7,a8,k;   // check_ppl: ignore (probe)
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,95,60,7,RGB(255,255,255));
  TEXTOUT_P("9a: 9 names in one LOCAL",G0,40,110,3,RGB(62,50,72));
  TEXTOUT_P("press Esc",G0,125,200,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;
