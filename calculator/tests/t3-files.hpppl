#pragma mode( separator(.,;) integer(h32) )
// Test 3: AFiles() listing, FOR, list append, !=, text measuring.
Boot(where)
BEGIN
  LOCAL k,fl,i,fn,n,pngs,w;
  pngs:={};
  fl:=AFiles();
  FOR i FROM 1 TO SIZE(fl) DO
    fn:=fl(i); n:=DIM(fn);
    IF n>4 THEN
      IF RIGHT(fn,4)==".png" AND fn!="icon.png" THEN   // check_ppl: ignore (the != bug, kept as a record)
        pngs(SIZE(pngs)+1):=fn;
      END;
    END;
  END;
  DIMGROB_P(G9,320,40);
  w:=TEXTOUT_P("IT BOOTS",G9,0,0,7,0);
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,IP((320-w)/2),40,7,RGB(255,255,255));
  TEXTOUT_P("test 3: files",G0,95,85,4,RGB(62,50,72));
  TEXTOUT_P("files: "+SIZE(fl)+"   pngs: "+SIZE(pngs),G0,80,115,3,RGB(62,50,72));
  IF SIZE(pngs)>0 THEN
    TEXTOUT_P("first: "+pngs(1),G0,60,140,3,RGB(62,50,72));
  END;
  TEXTOUT_P("text width: "+w,G0,100,165,3,RGB(62,50,72));
  TEXTOUT_P("press Esc",G0,125,200,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;

START()
BEGIN
  Boot("START");
END;
