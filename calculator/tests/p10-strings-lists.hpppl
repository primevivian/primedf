#pragma mode( separator(.,;) integer(h32) )
// Presence test p10-strings-lists: the boot screen plus ONE construct (LEFT/MIN/MAX/IP and a list parameter).
// If the app opens on the Function screen, this construct breaks it.
PdPick(l,j)
BEGIN
  RETURN l(j);
END;

START()
BEGIN
  LOCAL k,n,s,i,lst;
  n:=0; s:="";
  RECT_P(G0,0,0,319,239,RGB(255,143,171),RGB(255,143,171));
  TEXTOUT_P("IT BOOTS",G0,95,60,7,RGB(255,255,255));
  TEXTOUT_P("p10-strings-lists",G0,30,110,3,RGB(62,50,72));
  s:=LEFT("thesis.png",6);
  n:=MIN(3,7)+MAX(3,7)+IP(2);
  lst:={"a","b"};
  s:=PdPick(lst,2);
  TEXTOUT_P("ran ok",G0,130,140,3,RGB(62,50,72));
  TEXTOUT_P("press Esc",G0,125,200,3,RGB(62,50,72));
  REPEAT
    k:=GETKEY;
  UNTIL k==4;
END;
